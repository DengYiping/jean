				<string>osascript &lt;&lt;'APPLESCRIPT'
tell application "Jean" to activate
delay 0.05
tell application "System Events"
	if exists process "Jean" then
		tell process "Jean"
			set frontmost to true
			if (count of windows) &gt; 0 then
				try
					perform action "AXRaise" of window 1
				end try
			end if
		end tell
	end if
